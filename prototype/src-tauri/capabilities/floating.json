{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "floating-ball-capability",
  "description": "悬浮球窗口的最小记录、事件和窗口交互能力",
  "windows": ["floating-ball"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "allow-record-floating-paths",
    "allow-get-floating-recent",
    "allow-set-favorite",
    "allow-open-main-from-floating",
    "allow-load-floating-placement",
    "allow-save-floating-placement"
  ]
}
