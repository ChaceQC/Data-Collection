{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地资料工作台",
  "version": "0.3.30",
  "identifier": "cn.localmaterialworkbench.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1 --port 49217 --strictPort",
    "devUrl": "http://127.0.0.1:49217",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "本地资料工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost preview: http://preview.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost preview: http://preview.localhost blob: data:; media-src 'self' preview: http://preview.localhost blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "本地资料工作台"
      }
    }
  }
}
